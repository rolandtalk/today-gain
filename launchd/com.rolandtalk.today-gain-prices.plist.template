<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rolandtalk.today-gain-prices</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_PATH__</string>
    <string>__SKILL_OR_PROJECT_PATH__/scripts/today_gain_prices.py</string>
    <string>--db</string>
    <string>__DATABASE_PATH__/today_gain.sqlite3</string>
    <string>run</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>55</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>6</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>6</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>6</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>6</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>6</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>WorkingDirectory</key>
  <string>__WORKING_DIRECTORY__</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIRECTORY__/collector.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIRECTORY__/collector-error.log</string>
</dict>
</plist>
